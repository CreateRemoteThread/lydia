#!/usr/bin/env python3

import sys
import os
from typing import Annotated
import core.config
import core.memory
import core.mcp
import getopt
import readline

def ask_user(question: Annotated[str, "The question"]):
  return input(question + " > ").strip()
ask_user.__doc__ = "Ask the user a question"

MCPLoader = core.mcp.MCPLoader()

def loadPrompt(prompt):
  # return prompt
  if os.path.isfile(prompt):
    with open(prompt,"r") as f:
      try:
        print("loading prompt from %s" % prompt)
        return f.read()
      except:
        print("fatal: cannot open or read %s" % prompt)
        sys.exit(-1)
  else:
    return prompt

def main():
  global Toolbox
  CFG_INTERACTIVE = False
  CFG_USR_PROMPT = None
  CFG_PERSONALITY = "You are a helpful assistant."
  CFG_SYS_PROMPT = ""
  CFG_MODEL = None
  CFG_REASONING = None
  core.config.defaultcfg()
  try:
    args,extra = getopt.getopt(sys.argv[1:],"ic:p:s:m:r:",["cfg=","interactive","prompt=","system=","model=","reasoning=","persona=","mcp=","mcp-deny="])
  except getopt.GetoptError as e:
    print("getopt error: %s" % e)
    sys.exit(0)
  for arg,val in args:
    if arg in ["-c","--cfg"]:
      core.config.initcfg(val)
    elif arg in ["-p","--prompt"]:
      if CFG_USR_PROMPT is not None:
        print("fatal: do not supply -p twice")
        sys.exit(-1)
      CFG_USR_PROMPT = loadPrompt(val)
    elif arg in ["-i","--interactive"]:
      CFG_INTERACTIVE = True
    elif arg == "--mcp":
      MCPLoader.load_mcp(val)
    elif arg == "--mcp-deny":
      MCPLoader.blacklist(val)
    elif arg in ["-r","--reasoning"]:
      if val in ["low","medium","high"]:
        CFG_REASONING = val
      else:
        print("warn: r must be 'low', 'medium' or 'high' - reasoning remains None")
    elif arg in ["-s","--sysprompt"]:
      CFG_SYS_PROMPT = loadPrompt(val)
    elif arg in ["-m","--model"]:
      CFG_MODEL = val
    elif arg == "--persona":
      print("info: loading persona '%s'" % val)
      if os.path.isfile(val):
        with open(val) as f:
          CFG_PERSONALITY = f.read()
      else:
        print("warn: cannot open persona '%s'" % val)
  if core.config.getenv("OFF_WITH_HER_HEAD",default=None) is None:
    from core.agent import ResponseAgent as Agent
    # from core.agent import Agent
  else:
    print("info: off with her head! using anthropic-compatible agent core")
    from core.agent import MessagingAgent as Agent
  if CFG_MODEL is None:
    CFG_MODEL = core.config.getenv("OPENAI_DEFAULT_MODEL",default="gpt-4.1-mini-2025-04-14")
  got_riskaccept =  core.config.getenv("I_ACCEPT_THE_RISK",default=None)
  got_cmdfw = core.config.getenv("CMD_FW",default=None)
  got_vmsshargs = core.config.getenv("VM_SSHARGS",default=None)
  real_sys_prompt = " ".join([CFG_PERSONALITY,CFG_SYS_PROMPT])
  agent = Agent(sys_prompt=real_sys_prompt,model=CFG_MODEL,reasoning=CFG_REASONING)
  agent.set_mcploader(MCPLoader)
  if CFG_USR_PROMPT is None:
    if CFG_INTERACTIVE is False:
      print("fatal: you must at least a user prompt with -p or use -i for interactive")
      sys.exit(-1)
    else:
      print("info: -i set, asking user for initial prompt")
      CFG_USR_PROMPT = input(" > ").rstrip()
      if CFG_USR_PROMPT.startswith("!"):
        print("fatal: you cannot use core.memory.memory_dispatch with 0 memory")
        sys.exit(-1)
  if CFG_INTERACTIVE is False:
    result = agent.req_loop(CFG_USR_PROMPT)
    print(result)
    sys.exit(0)
  else:
    result = agent.req_loop(CFG_USR_PROMPT)
    while True:
      if result is not None: # don't print the result on !reset
        print(result)
      new_prompt = input(" > ").rstrip() 
      if new_prompt in ["/exit","/quit",":wq",":q","quit()","q"]:
        break
      if new_prompt.startswith("!"):    # special utility function.
        core.memory.memory_dispatch(new_prompt[1:], agent) 
        result = None
        continue
      else:
        result = agent.req_loop(new_prompt)
    print("Bye!")

if __name__ == "__main__":
  main()
